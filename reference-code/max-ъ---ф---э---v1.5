		public bool canOpen(string fullPath)
		{
			if (!beginReadPending)
			{
				IntPtr intPtr = new IntPtr(-1);
				if (fullPath != null && fullPath != "")
				{
					intPtr = windowsApi.CreateDeviceFile(fullPath);
					windowsApi.CloseDeviceFile(intPtr);
				}
				return intPtr != new IntPtr(-1);
			}
			return true;
		}

		public bool Open(string fullPath)
		{
			try
			{
				if (beginReadPending || IsOpened())
				{
					return true;
				}
				deviceFileHander = windowsApi.CreateDeviceFile(fullPath);
				if (deviceFileHander == new IntPtr(-1))
				{
					return false;
				}
				beginReadPending = false;
				devicePath = fullPath;
				windowsApi.GETDeviceAttribute(deviceFileHander, out var attributes);
				VersionNumber = attributes.VersionNumber;
				windowsApi.GetPreparseData(deviceFileHander, out var preparseData);
				windowsApi.GetCaps(preparseData, out Hid_Caps);
				windowsApi.FreePreparseData(preparseData);
				if (Hid_Caps.InputReportByteLength > 0)
				{
					hidDevice = new FileStream(new SafeFileHandle(deviceFileHander, ownsHandle: false), FileAccess.ReadWrite, Hid_Caps.InputReportByteLength, isAsync: false);
				}
				else if (Hid_Caps.OutputReportByteLength > 0)
				{
					hidDevice = new FileStream(new SafeFileHandle(deviceFileHander, ownsHandle: false), FileAccess.ReadWrite, Hid_Caps.OutputReportByteLength, isAsync: false);
				}
				return true;
			}
