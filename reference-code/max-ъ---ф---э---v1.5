		public static GraphicsPath GetRoundedRectPath(Rectangle rect, int radius, GraphRectDirection rectDirection)
		{
			Rectangle rect2 = new Rectangle(rect.Location, new Size(radius, radius));
			GraphicsPath graphicsPath = new GraphicsPath();
			if ((rectDirection & GraphRectDirection.LeftUp) > (GraphRectDirection)0 && radius > 0)
			{
				graphicsPath.AddArc(rect2, 180f, 90f);
			}
			else
			{
				graphicsPath.AddLine(new Point(rect.Left, rect.Top), new Point(rect.Left, rect.Top + radius));
				graphicsPath.AddLine(new Point(rect.Left, rect.Top), new Point(rect.Left + radius, rect.Top));
			}
			rect2.X = rect.Right - radius;
			if ((rectDirection & GraphRectDirection.RightUp) > (GraphRectDirection)0 && radius > 0)
			{
				graphicsPath.AddArc(rect2, 270f, 90f);
			}
			else
			{
				graphicsPath.AddLine(new Point(rect.Right, rect.Top), new Point(rect.Right - radius, rect.Top));
				graphicsPath.AddLine(new Point(rect.Right, rect.Top), new Point(rect.Right, rect.Top + radius));
			}
			rect2.Y = rect.Bottom - radius;
			if ((rectDirection & GraphRectDirection.RightDown) > (GraphRectDirection)0 && radius > 0)
			{
				graphicsPath.AddArc(rect2, 0f, 90f);
			}
			else
			{
				graphicsPath.AddLine(new Point(rect.Right, rect.Bottom), new Point(rect.Right, rect.Bottom - radius));
				graphicsPath.AddLine(new Point(rect.Right, rect.Bottom), new Point(rect.Right + radius, rect.Bottom));
			}
			rect2.X = rect.Left;
			if ((rectDirection & GraphRectDirection.LeftDown) > (GraphRectDirection)0 && radius > 0)
			{
				graphicsPath.AddArc(rect2, 90f, 90f);
			}
			else
			{
				graphicsPath.AddLine(new Point(rect.Left, rect.Bottom), new Point(rect.Left - radius, rect.Bottom));
				graphicsPath.AddLine(new Point(rect.Left, rect.Bottom), new Point(rect.Left, rect.Bottom - radius));
			}
			graphicsPath.CloseFigure();
			return graphicsPath;
		}

		public static void FillRect(Graphics g, Rectangle frameRect, int Radius, Color backColor, int frameWidth, Color frameColor, GraphRectDirection rectDirection)
		{
			g.SetGDIHigh();
			GraphicsPath graphicsPath;
			if (Radius > 0)
			{
				graphicsPath = GetRoundedRectPath(frameRect, Radius, rectDirection);
			}
			else
			{
				graphicsPath = new GraphicsPath();
				graphicsPath.AddRectangle(frameRect);
				graphicsPath.CloseFigure();
			}
			g.FillPath(new SolidBrush(backColor), graphicsPath);
			if (frameWidth > 0)
			{
				Pen pen = new Pen(frameColor, frameWidth);
				g.DrawPath(pen, graphicsPath);
			}
		}

