				TagFileEventArgs tagFileEventArgs = new TagFileEventArgs(fiSource, fiDest);
				onPreTagFile(tagFileEventArgs);
				if (tagFileEventArgs.Handled)
				{
					fiDest = tagFileEventArgs.DstFile;
				}
			}
			if (fiDest.FullName == fiSource.FullName && !mbAllowSourceEqualDest)
			{
