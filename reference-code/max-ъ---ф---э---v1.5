		public List<string> LoadBTNames()
		{
			List<string> list = new List<string>();
			list.Clear();
			try
			{
				using FileStream stream = new FileStream(NRFFile.GetConfigFIleName(), FileMode.Open);
				using StreamReader streamReader = new StreamReader(stream, Encoding.Default);
				string text;
				while ((text = streamReader.ReadLine()) != null)
				{
					string[] array = text.Split(new char[1] { '=' });
					if (array.Length == 2)
					{
						list.Add(array[1]);
					}
				}
			}
			catch
			{
			}
			return list;
		}

		private void UpdateBtNames()
		{
			string configFIleName = NRFFile.GetConfigFIleName();
			FileStream fileStream = File.Open(configFIleName, FileMode.OpenOrCreate, FileAccess.Write);
			fileStream.Seek(0L, SeekOrigin.Begin);
			fileStream.SetLength(0L);
			fileStream.Close();
			StreamWriter streamWriter = new StreamWriter(configFIleName, append: true, Encoding.GetEncoding("gb2312"));
			for (int i = 0; i < BtNamesList.Count; i++)
			{
				streamWriter.WriteLine("Name=" + BtNamesList[i]);
			}
			streamWriter.Flush();
			streamWriter.Close();
		}

		private void UILoadBtName()
		{
			BtNamesList = LoadBTNames();
			((DataGridView)customDataGridView1).Rows.Clear();
			for (int i = 0; i < BtNamesList.Count; i++)
			{
				((DataGridView)customDataGridView1).Rows.Add(new object[1] { BtNamesList[i] });
			}
		}

