		private ImageInfo GetImageInfo(string cid, string pid, string productName)
		{
			ImageInfo result = null;
			for (int i = 0; i < products.Count; i++)
			{
				if (cid == products[i].Cid && pid == products[i].Pid && products[i].productName == productName)
				{
					result = products[i];
					break;
				}
			}
			return result;
		}

