			isCheckPid = false;
		}

		public void TimerCallBack(object sender, EventArgs e)
		{
			PairResults pairResults = PairResults.None;
			byte[] array = new byte[4];
			byte[] feature = usbDeviceSet.GetFeature(2, 7, 9);
			escapedTime = ++pair_timer_count / 5;
			if (feature != null)
			{
				readCount = 0;
				if (feature[1] == 160)
				{
					if (feature[2] == 3 || feature[2] == 11)
					{
						if (!isCheckPid)
						{
							Array.Copy(feature, 5, array, 0, 4);
							CheckPid();
							pairResults = PairResults.OK;
							isCheckPid = true;
						}
					}
					else if (feature[2] == 2)
					{
						pair_timer_count = 0;
						pairingTimer.Enabled = false;
						pairResults = PairResults.Fail;
					}
				}
			}
			else if (++readCount > 3)
			{
				StopPair();
				pairResults = PairResults.ReadFail;
			}
			if ((pairResults == PairResults.None || pairResults == PairResults.ReadFail) && escapedTime >= 20)
			{
				pair_timer_count = 0;
				pairingTimer.Enabled = false;
				pairResults = PairResults.Fail;
			}
			ShowPairingInfo(pairResults, ByteToHexString(array));
		}

		internal static string ByteToHexString(byte[] p)
		{
			string text = string.Empty;
			if (p != null)
			{
				for (int i = 0; i < p.Length; i++)
				{
					text = text + p[i].ToString("X2") + " ";
				}
			}
			return text;
		}

		public void StartPair()
		{
			if (((Control)wButton_Pair).Enabled)
			{
				pair_timer_count = 0;
				escapedTime = 0;
				autoPairTimer.Stop();
				pairingTimer.Enabled = true;
				isCheckPid = false;
				pairStateLabel.SetText("");
				((Control)wButton_Pair).Enabled = false;
				wButton_Pair.SetDefaultBackColor(rightNow: false);
				usbDeviceSet.WriteFeature(2, new byte[8]
				{
					7,
					160,
					MouseImageFile.Cid,
					MouseImageFile.Pid,
					0,
					0,
					0,
					0
				});
			}
		}

		public static byte GetCommandCRC(byte[] cmd)
		{
			int num = 0;
			for (int i = 0; i < cmd.Length; i++)
			{
				num += cmd[i];
			}
			byte b = (byte)((uint)num & 0xFFu);
			return (byte)(85 - b);
		}

		private void CheckPid()
		{
			byte[] array = new byte[15]
			{
				8, 4, 0, 1, 252, 3, 0, 0, 0, 0,
				0, 0, 0, 0, 0
			};
			array[14] = GetCommandCRC(array);
			usbDeviceSet.WriteFeature(0, array);
		}

		public void StopPair()
		{
			pair_timer_count = 0;
			escapedTime = 0;
			isCheckPid = false;
			pairingTimer.Enabled = false;
			pairingTimer.Stop();
		}

		private void usbHID_DataReceived(object sender, EventArgs e)
		{
			report report = (report)e;
			if (report.reportID != 9 || report.reportBuff == null || report.reportBuff.Length < 8)
			{
				return;
			}
			byte[] array = new byte[report.reportBuff.Length + 1];
			array[0] = report.reportID;
			Array.Copy(report.reportBuff, 0, array, 1, report.reportBuff.Length - 1);
			array[report.reportBuff.Length] = 0;
			byte commandCRC = GetCommandCRC(array);
			byte b = report.reportBuff[5];
			byte b2 = report.reportBuff[6];
			byte b3 = report.reportBuff[7];
			StopPair();
			if (commandCRC == report.reportBuff[report.reportBuff.Length - 1])
			{
				byte[] array2 = new byte[3];
				array2[0] = b;
				array2[1] = b2;
				array2[2] = 0;
				array2[2] = GetCommandCRC(array2);
				if (array2[2] == b3 && b == MouseImageFile.Cid && b2 == MouseImageFile.Pid)
				{
					ShowPairingInfo(PairResults.PID_OK, b2.ToString());
					return;
				}
			}
			ShowPairingInfo(PairResults.PID_Fail, b2.ToString());
		}

