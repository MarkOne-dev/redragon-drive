		{
			FileInfo[] files = diSource.GetFiles(searchPattern, searchOption);
			if (!diDest.Exists)
			{
				diDest.Create();
			}
			FileInfo[] array = files;
			foreach (FileInfo fileInfo in array)
			{
				FileInfo fiDest = new FileInfo(fileInfo.FullName.Replace(diSource.FullName, diDest.FullName));
				TagFile(fileInfo, fiDest);
			}
		}

		public void TagFile(FileInfo fiSource, FileInfo fiDest)
		{
