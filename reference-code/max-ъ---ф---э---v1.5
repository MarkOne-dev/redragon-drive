		private void LoadLanguageId()
		{
			string text = RegistryStorage.OpenAfterStart();
			if (StringHelper.IsIHexString(text))
			{
				int num = Convert.ToInt32(text);
				if (num < comboBox_language.Items.Count)
				{
					((ListControl)comboBox_language).SelectedIndex = num;
				}
				else
				{
					((ListControl)comboBox_language).SelectedIndex = 0;
				}
			}
			else
			{
				((ListControl)comboBox_language).SelectedIndex = 0;
			}
		}

		private void comboBox_language_SelectedIndexChanged(object sender, EventArgs e)
		{
			if (((ListControl)comboBox_language).SelectedIndex < 0)
			{
				return;
			}
			LanguageId = ((ListControl)comboBox_language).SelectedIndex;
			string text = ((ListControl)comboBox_language).SelectedIndex.ToString("X1");
			string text2 = RegistryStorage.OpenAfterStart();
			if (StringHelper.IsIHexString(text2))
			{
				if (!text.Equals(text2))
				{
					RegistryStorage.SaveBeforeExit(text);
					Language.Update();
					LoadMultiLanguage();
					if (parent != null)
					{
						parent.LoadMultiLanguage();
						_ = parent.application;
					}
				}
			}
			else
			{
				RegistryStorage.SaveBeforeExit(text);
			}
		}

