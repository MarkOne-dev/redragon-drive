	public class MouseReportRate
	{
		private const int REPORT_RATE_LENGTH = 4;

		private FormMain parent;

		private List<long> pointElapsedTimeList = new List<long>();

		private List<long> pointStartTimeList = new List<long>();

		private List<long> reportRateList = new List<long>();

		private Stopwatch stopwatch = new Stopwatch();

		public int currentReportRate;

		private Font normalReportRateFont = new Font("微软雅黑", 54f, FontStyle.Bold);

		private Font supperReportRateFont = new Font("微软雅黑", 200f);

		public Rectangle normalReportRateRect = new Rectangle(800, 0, 76, 88);

		public Rectangle supperReportRateRect = new Rectangle(800, 0, 240, 300);

		private bool reportRateStarting = true;

		private BackgroundLabel[] reportRateLabels = new BackgroundLabel[4];

		public MouseReportRate()
		{
			stopwatch.Start();
			for (int i = 0; i < reportRateLabels.Length; i++)
			{
				reportRateLabels[i] = new BackgroundLabel("");
			}
		}

		public void SetParent(FormMain parent)
		{
			this.parent = parent;
			for (int i = 0; i < reportRateLabels.Length; i++)
			{
				reportRateLabels[i].SetParent(parent);
			}
			SetLocation(((Control)parent).Width, ((Control)parent).Height);
		}

		public void SetBackColor(Color color)
		{
			for (int i = 0; i < reportRateLabels.Length; i++)
			{
				reportRateLabels[i].SetBackColor(color);
			}
		}

		public void SetVisable(bool visable)
		{
			reportRateList.Clear();
			pointElapsedTimeList.Clear();
			currentReportRate = ((!visable) ? (-1) : 0);
			Show();
			currentReportRate = 0;
		}

		public void clear()
		{
			reportRateList.Clear();
			pointElapsedTimeList.Clear();
			pointStartTimeList.Clear();
			currentReportRate = 0;
			reportRateStarting = true;
			Show();
		}

		private bool CalcReportRateAvg(int startPointCount, int calcPointCount, bool removeFirst, ref List<long> pointList)
		{
			if (pointElapsedTimeList.Count >= startPointCount)
			{
				long num = pointElapsedTimeList.Last() - pointElapsedTimeList.First();
				if (pointList.Count == 0 || num >= pointList.Last())
				{
					pointList.Add(num);
				}
				else
				{
					pointList.Insert(pointList.Count - 1, num);
				}
				if (removeFirst)
				{
					pointElapsedTimeList.RemoveAt(0);
				}
				if (pointList.Count >= calcPointCount)
				{
					long num2 = 0L;
					int num3 = calcPointCount / 4;
					int num4 = calcPointCount - calcPointCount / 4;
					for (int i = num3; i < num4; i++)
					{
						num2 += pointList[i];
					}
					pointList.Clear();
					int num5 = startPointCount * (num4 - num3);
					currentReportRate = (int)(num5 * 1000 / num2);
					return true;
				}
			}
			return false;
		}

		public void CalcReportRate()
		{
			pointElapsedTimeList.Add(stopwatch.ElapsedMilliseconds);
			if (CalcReportRateAvg(128, 128, removeFirst: true, ref reportRateList))
			{
				reportRateStarting = false;
			}
			else if (reportRateStarting)
			{
				CalcReportRateAvg(32, 16, removeFirst: false, ref pointStartTimeList);
			}
		}

		public void Show()
		{
			if (parent == null || FormSetting.dpiMode)
			{
				return;
			}
			string text = ((currentReportRate == -1) ? "" : currentReportRate.ToString());
			text = text.PadLeft(4, ' ');
			string text2 = "";
			for (int i = 0; i < reportRateLabels.Length; i++)
			{
				text2 = text.Substring(i, 1);
				if (text2 != reportRateLabels[i].Text)
				{
					reportRateLabels[i].SetText(text2);
				}
			}
		}

		public void SetLocation(int screenWidth, int screenHeight)
		{
			normalReportRateRect.X = screenWidth - normalReportRateRect.Width * 4 - 32;
			if (FormSetting.supperReportRateInLeft)
			{
				supperReportRateRect.X = 0;
				supperReportRateRect.Y = 100;
			}
			else
			{
				supperReportRateRect.X = screenWidth - supperReportRateRect.Width * 4 - 32;
			}
			Font font = (FormSetting.reportRateSupperFont ? supperReportRateFont : normalReportRateFont);
			Rectangle rect = (FormSetting.reportRateSupperFont ? supperReportRateRect : normalReportRateRect);
			for (int i = 0; i < 4; i++)
			{
				reportRateLabels[i].SetRect(rect);
				reportRateLabels[i].SetFont(font);
				rect.X += rect.Width;
			}
		}

		public void UpdateLocation()
		{
			if (parent != null)
			{
				currentReportRate = -1;
				Show();
				SetLocation(((Control)parent).Width, ((Control)parent).Height);
				currentReportRate = 0;
				Show();
			}
		}

		public void SetForeColor(Color color)
		{
			for (int i = 0; i < reportRateLabels.Length; i++)
			{
				if (reportRateLabels[i] != null)
				{
					reportRateLabels[i].SetForeColor(color);
				}
			}
		}
	}
