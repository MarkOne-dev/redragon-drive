	public class DriverResourceList : List<DriverResource>
	{
		public new bool Add(DriverResource driverResource)
		{
			bool flag = false;
			using (Enumerator enumerator = GetEnumerator())
			{
				while (enumerator.MoveNext())
				{
					DriverResource current = enumerator.Current;
					Dictionary<string, string> strings = current.Strings;
					Dictionary<string, string> strings2 = current.Strings;
					if (!(current.DisplayName == driverResource.DisplayName))
					{
						continue;
					}
					flag = true;
					foreach (string key in strings.Keys)
					{
						if (!strings2.TryGetValue(key, out var value))
						{
							flag = false;
							break;
						}
						if (strings[key] != value)
						{
							flag = false;
							break;
						}
					}
					if (flag)
					{
						break;
					}
				}
			}
			if (flag)
			{
				return false;
			}
			base.Add(driverResource);
			return true;
		}
	}
