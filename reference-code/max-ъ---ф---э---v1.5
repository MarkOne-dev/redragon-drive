			{
				mTagList = new TagNReplaceList(mTagKeyComparer);
			}
			else
			{
				mTagList = new TagNReplaceList(mTagKeyComparer, mTagList);
			}
		}

		private void validateRegexFormatter()
		{
			if (mReg == null)
			{
				mTagValueFormatters.IsModifed = true;
			}
			if (mTagValueFormatters.IsModifed)
			{
				mReg = mTagValueFormatters.NewRegExp(mbIgnoreTagCase);
			}
		}

		protected virtual string defaultReplaceHandler(Match m)
		{
			FormatterCollection.RegExGrpItem regExGrpItem = null;
			if (!m.Groups[mTagValueFormatters.IdxTagValue].Success)
			{
				throw new Exception("defaultReplaceHandler:\r\nTagValue expression does not exist in match.");
			}
			foreach (FormatterCollection.RegExGrpItem item in mTagValueFormatters.RegExGroup)
			{
				if (m.Groups[item.GroupNumber].Success)
				{
					regExGrpItem = item;
					break;
				}
			}
			if (regExGrpItem != null)
			{
				string Value = m.Groups[mTagValueFormatters.IdxTagValue].Value;
				TagValueFormatterArgs tagValueFormatterArgs = new TagValueFormatterArgs(m, mTagList, ref Value);
				regExGrpItem.Formatter.Format(tagValueFormatterArgs);
				if (tagValueFormatterArgs.Handled)
				{
					if (tagValueFormatterArgs.PostFormatReturnValue)
					{
						return TagString(ref tagValueFormatterArgs.ReturnValue);
					}
					return tagValueFormatterArgs.ReturnValue;
				}
				return m.Value;
			}
			throw new Exception("defaultReplaceHandler:\r\nUnhandled tagged expression.");
		}
	}
