		public SetupApi.DICFG DICFGFlags => (SetupApi.DICFG)(mFlags & DEIFlags.DICFG_MASK);

		public bool SkipWindowsServices => (mFlags & DEIFlags.IncludeWindowsServices) == 0;

		public bool DriverlessOnly => (mFlags & DEIFlags.Driverless) == DEIFlags.Driverless;

		public List<DeviceItem> DeviceList => deviceList;

		public DeviceEnumeratorInfo(DEIFlags flags, IntPtr hwnd)
		{
