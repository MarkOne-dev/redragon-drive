		private List<DeviceItem> GetUsbList(bool connnectedOnly, bool driverLessOnly)
		{
			DEIFlags dEIFlags = DEIFlags.DICFG_AllClasses;
			if (connnectedOnly)
			{
				dEIFlags |= DEIFlags.DICFG_Present;
			}
			if (driverLessOnly)
			{
				dEIFlags |= DEIFlags.Driverless;
			}
			dEIFlags |= DEIFlags.IncludeWindowsServices;
			DeviceEnumeratorInfo deviceEnumeratorInfo = new DeviceEnumeratorInfo(dEIFlags, ((Control)this).Handle);
			List<DeviceItem> deviceList = deviceEnumeratorInfo.DeviceList;
			DeviceSelectionHelper.EnumerateDevices(deviceEnumeratorInfo);
			return deviceList;
		}

		public void UpdateUsbList()
		{
			mDeviceList = GetUsbList(checkBox_connected.Checked, checkBox_driverless.Checked);
			List<DeviceItem> list = new List<DeviceItem>();
			List<DeviceItem> list2 = new List<DeviceItem>();
			bool flag = false;
			foreach (DeviceItem mDevice in mDeviceList)
			{
				flag = false;
				for (int i = 0; i < dataGridViewUsbList.RowCount; i++)
				{
					if (dataGridViewUsbList.Rows[i].Cells[0].Value.ToString() == mDevice.VendorID && dataGridViewUsbList.Rows[i].Cells[1].Value.ToString() == mDevice.ProductID && dataGridViewUsbList.Rows[i].Cells[5].Value.ToString() == mDevice.mDeviceId)
					{
						list.Add(mDevice);
						flag = true;
						break;
					}
				}
				if (!flag)
				{
					list2.Add(mDevice);
				}
			}
			if (list2.Count == 0 && dataGridViewUsbList.RowCount == list.Count)
			{
				return;
			}
			dataGridViewUsbList.Rows.Clear();
			foreach (DeviceItem item in list)
			{
				int num = dataGridViewUsbList.Rows.Add(new object[6] { item.VendorID, item.ProductID, item.DeviceDescription, item.Manufacturer, item.mDriverless, item.mDeviceId });
				((DataGridViewBand)dataGridViewUsbList.Rows[num]).Tag = item;
				item.ResetDirty();
			}
			foreach (DeviceItem item2 in list2)
			{
				int num2 = dataGridViewUsbList.Rows.Add(new object[6] { item2.VendorID, item2.ProductID, item2.DeviceDescription, item2.Manufacturer, item2.mDriverless, item2.mDeviceId });
				((DataGridViewBand)dataGridViewUsbList.Rows[num2]).Tag = item2;
				item2.ResetDirty();
				if (list.Count > 0)
				{
					((DataGridViewBand)dataGridViewUsbList.Rows[num2]).DefaultCellStyle.BackColor = Color.Coral;
				}
			}
			if (((BaseCollection)dataGridViewUsbList.SelectedRows).Count > 0)
			{
				mCurrentDeviceItem = (DeviceItem)((DataGridViewBand)dataGridViewUsbList.SelectedRows[0]).Tag;
			}
		}

