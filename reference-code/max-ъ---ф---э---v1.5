		private Pen dotTrackerPen = new Pen(Color.Red, 1f);

		private Pen linePen = new Pen(Color.Red, 2f);

		public Point[] movePoints = new Point[2];

		private Point[] moveZoomPoints = new Point[2];

		public MouseMove()
		{
			SetDotPenColor(Color.Black);
			linePen.DashStyle = DashStyle.Solid;
		}

		public void SetParent(FormMain parent)
		{
			this.parent = parent;
		}

		public void clear()
		{
			if (parent != null)
			{
				movePoints[0] = ((Control)parent).PointToClient(Control.MousePosition);
				movePoints[1] = movePoints[0];
				moveZoomPoints[0] = movePoints[0];
				moveZoomPoints[1] = movePoints[0];
				Show(movePoints[0].X, movePoints[0].Y);
			}
		}

		public void Show(int moveX, int moveY)
		{
			movePoints[0].X = moveX;
			movePoints[0].Y = moveY;
			if (parent == null)
			{
				return;
			}
			if (FormSetting.zoomStep > 1)
			{
				moveZoomPoints[0].X = moveZoomPoints[1].X + (movePoints[0].X - movePoints[1].X) * FormSetting.zoomStep;
				moveZoomPoints[0].Y = moveZoomPoints[1].Y + (movePoints[0].Y - movePoints[1].Y) * FormSetting.zoomStep;
				LocationLimit(ref moveZoomPoints[0]);
			}
			Point[] array = ((FormSetting.zoomStep > 1) ? moveZoomPoints : movePoints);
			Rectangle rectFromPoints = GetRectFromPoints(array[0], array[1]);
			rectFromPoints.Width += 2;
			rectFromPoints.Height += 2;
			if (FormSetting.autoMode)
			{
				if (FormSetting.lineMode)
				{
					parent.backgroundGraphics.DrawCurve(linePen, array);
					((Control)parent).Invalidate(rectFromPoints);
				}
				else
				{
					parent.backgroundGraphics.DrawCurve(dotTrackerPen, array);
					parent.backgroundGraphics.DrawLine(dotPen, array[0].X, array[0].Y, array[0].X + 1, array[0].Y + 1);
					((Control)parent).Invalidate(rectFromPoints);
				}
			}
			movePoints[1] = movePoints[0];
			moveZoomPoints[1] = moveZoomPoints[0];
		}

		public void LocationLimit(ref Point location)
		{
			if (location.X < 0)
			{
				location.X = 0;
			}
			if (location.Y < 0)
			{
				location.Y = 0;
			}
			if (location.X > ((Control)parent).Width)
			{
				location.X = ((Control)parent).Width;
			}
			if (location.Y > ((Control)parent).Height)
			{
				location.Y = ((Control)parent).Height;
			}
		}

		private Rectangle GetRectFromPoints(Point point1, Point point2)
		{
			return (point1.X < point2.X) ? ((point1.Y >= point2.Y) ? new Rectangle(point1.X, point2.Y, point2.X - point1.X, point1.Y - point2.Y) : new Rectangle(point1.X, point1.Y, point2.X - point1.X, point2.Y - point1.Y)) : ((point1.Y >= point2.Y) ? new Rectangle(point2.X, point2.Y, point1.X - point2.X, point1.Y - point2.Y) : new Rectangle(point2.X, point1.Y, point1.X - point2.X, point2.Y - point1.Y));
		}

		public void SetColor(Color color)
		{
			dotTrackerPen.Color = color;
			linePen.Color = color;
		}

		public void SetDotPenColor(Color color)
		{
			dotPen.Brush = new SolidBrush(Color.FromArgb(255, color));
		}
