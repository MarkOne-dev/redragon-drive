		private void onUsbDeviceChanged()
		{
			if (parent == null)
			{
				return;
			}
			USBDevice uSBDevice = usbDeviceSet.GetUSBDevice();
			bool found = uSBDevice != null;
			AppLog.LogOnUsbChanged(usbDeviceSet, found);
			((Control)parent).Invoke((Delegate)(Action)delegate
			{
				formFactory.UIEnable(found);
				pairStateLabel.SetText("");
				((Control)wButton_Pair).Text = Language.GetString("GamingPro2635_PairStart", "对码(Enter)");
				((Control)wButton_Pair).Enabled = found;
				wButton_Pair.SetDefaultBackColor(found);
				if (found)
				{
					string shortDevicePath = uSBDevice.EndPoints[0].shortDevicePath;
					string text = shortDevicePath.Substring(4, 4);
					string text2 = shortDevicePath.Substring(13, 4);
					UsbPidVidLabel.SetText("VID: " + text.ToUpper() + "    PID: " + text2.ToUpper());
					int num = uSBDevice.EndPoints[0].VersionNumber >> 8;
					int num2 = uSBDevice.EndPoints[0].VersionNumber & 0xFF;
					UsbVersionLabel.SetText("Version:" + num.ToString("X") + "." + num2.ToString("X"));
				}
				else
				{
					StopPair();
					UsbPidVidLabel.SetText("");
					UsbVersionLabel.SetText("");
				}
				if (found && checkBox_autoPair.Checked)
				{
					autoPairTimer.Stop();
					autoPairTimer.Start();
				}
			});
		}

		private void ShowPairingInfo(PairResults result, string param, string param2)
		{
			if (parent == null)
			{
				return;
			}
			switch (result)
			{
			case PairResults.None:
				((Control)parent).Invoke((Delegate)(Action)delegate
				{
					int num = ((escapedTime <= 20) ? (20 - escapedTime) : 0);
					((Control)wButton_Pair).Text = num + Language.GetString("GamingPro2635_Second", "秒");
				});
				break;
			case PairResults.OK:
				usbAddr = param;
				pairStateLabel.SetForeColor(Color.Green);
				pairStateLabel.SetText(Language.GetString("GamingPro2635_AddrCompleted", "地址接收完成，正在读取CID和MID……"));
				break;
			case PairResults.ReadFail:
				pairStateLabel.SetForeColor(Color.Red);
				pairStateLabel.SetText(Language.GetString("GamingPro2635_USBError", "USB错误！"));
				usbAddr = "";
				((Control)parent).Invoke((Delegate)(Action)delegate
				{
					((Control)wButton_Pair).Enabled = true;
					wButton_Pair.SetBackColor(Color.Red);
				});
				break;
			case PairResults.Fail:
				usbAddr = "";
				((Control)parent).Invoke((Delegate)(Action)delegate
				{
					((Control)wButton_Pair).Enabled = true;
					wButton_Pair.SetBackColor(Color.Red);
					((Control)wButton_Pair).Text = Language.GetString("GamingPro2635_PairTimeout", "配对超时！");
					pairStateLabel.SetText("");
				});
				break;
			case PairResults.PID_OK:
				pairStateLabel.SetForeColor(Color.Green);
				pairStateLabel.SetText(Language.GetString("GamingPro2635_Addr", "地址：") + usbAddr + "    CID：" + param + "    MID：" + param2);
				((Control)parent).Invoke((Delegate)(Action)delegate
				{
					((Control)wButton_Pair).Enabled = true;
					wButton_Pair.SetDefaultBackColor(rightNow: true);
					((Control)wButton_Pair).Text = Language.GetString("GamingPro2635_PairSuccess", "配对成功！");
				});
				break;
			case PairResults.PID_Fail:
				pairStateLabel.SetForeColor(Color.Red);
				pairStateLabel.SetText(Language.GetString("GamingPro2635_Addr", "地址：") + usbAddr + "    PID：" + param);
				((Control)parent).Invoke((Delegate)(Action)delegate
				{
					((Control)wButton_Pair).Enabled = true;
					wButton_Pair.SetBackColor(Color.Red);
					((Control)wButton_Pair).Text = Language.GetString("GamingPro2635_PairFail", "配对失败！");
				});
				break;
			}
		}
	}
	public class Language
	{
		private static Dictionary<string, string> DicLanguage = new Dictionary<string, string>();

		private static string GetLanguageXmlFileName(int LanguageId)
		{
			string result = "Chinese";
			switch (LanguageId)
			{
			case 0:
				result = "Chinese";
				break;
			case 1:
				result = "English";
				break;
			}
			return result;
		}

		protected static void XmlLoad(string language)
		{
			try
			{
				Assembly executingAssembly = Assembly.GetExecutingAssembly();
				Stream manifestResourceStream = executingAssembly.GetManifestResourceStream("CompxTester.Languages." + language + ".xml");
				if (manifestResourceStream == null)
				{
					manifestResourceStream = executingAssembly.GetManifestResourceStream("CompxTester.Languages.Chinese.xml");
				}
				XmlDocument xmlDocument = new XmlDocument();
				xmlDocument.Load(manifestResourceStream);
				foreach (XmlNode childNode in xmlDocument.DocumentElement.ChildNodes)
				{
					DicLanguage.Add(childNode.Name, childNode.InnerText);
				}
			}
			catch (Exception ex)
			{
				throw ex;
			}
		}

		public static void Update()
		{
			DicLanguage.Clear();
		}

		public static string GetString(string key, string defaultString)
		{
			if (DicLanguage.Count == 0)
			{
				XmlLoad(GetLanguageXmlFileName(FormSetting.LanguageId));
			}
			if (DicLanguage.ContainsKey(key))
			{
				return DicLanguage[key];
			}
			return defaultString;
		}
	}
