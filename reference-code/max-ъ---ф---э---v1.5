	internal static class Wdi
	{
		public static int UpdateDriver(string deviceHardwareID)
		{
			int num = 0;
			SetupApi.SP_DEVINFO_DATA DeviceInfoData = default(SetupApi.SP_DEVINFO_DATA);
			IntPtr intPtr = SetupApi.SetupDiGetClassDevs(0, "USB", IntPtr.Zero, SetupApi.DICFG.ALLCLASSES);
			if (intPtr == IntPtr.Zero || intPtr == new IntPtr(-1))
			{
				return num;
			}
			int num2 = 0;
			while (true)
			{
				DeviceInfoData.cbSize = (uint)Marshal.SizeOf(typeof(SetupApi.SP_DEVINFO_DATA));
				if (!SetupApi.SetupDiEnumDeviceInfo(intPtr, num2, ref DeviceInfoData) || !SetupApi.SetupDiGetDeviceRegistryProperty(out string[] regMultiSZ, intPtr, ref DeviceInfoData, SetupApi.SPDRP.HARDWAREID))
				{
					break;
				}
				if (regMultiSZ.Length != 0)
				{
					bool flag = false;
					string[] array = regMultiSZ;
					for (int i = 0; i < array.Length; i++)
					{
						if (array[i].Trim().ToLower() == deviceHardwareID.Trim().ToLower())
						{
							flag = true;
							break;
						}
					}
					if (flag)
					{
						switch (SetupApi.CM_Reenumerate_DevNode((int)DeviceInfoData.DevInst, SetupApi.CM.REENUMERATE_RETRY_INSTALLATION))
						{
						case SetupApi.CR.SUCCESS:
							num++;
							break;
						}
					}
				}
				num2++;
			}
			return num;
		}

		public static int CheckRemoved(string deviceHardwareID)
		{
			int num = 0;
			SetupApi.SP_DEVINFO_DATA DeviceInfoData = default(SetupApi.SP_DEVINFO_DATA);
			DeviceInfoData.cbSize = (uint)Marshal.SizeOf(typeof(SetupApi.SP_DEVINFO_DATA));
			IntPtr intPtr = SetupApi.SetupDiGetClassDevs(0, "USB", IntPtr.Zero, SetupApi.DICFG.ALLCLASSES);
			if (intPtr == IntPtr.Zero || intPtr == new IntPtr(-1))
			{
				return num;
			}
			for (int i = 0; SetupApi.SetupDiEnumDeviceInfo(intPtr, i, ref DeviceInfoData); i++)
			{
				if (!SetupApi.SetupDiGetDeviceRegistryProperty(out string[] regMultiSZ, intPtr, ref DeviceInfoData, SetupApi.SPDRP.HARDWAREID))
				{
					break;
				}
				if (regMultiSZ.Length == 0)
				{
					continue;
				}
				bool flag = false;
				string[] array = regMultiSZ;
				for (int j = 0; j < array.Length; j++)
				{
					if (array[j].Trim().ToLower() == deviceHardwareID.Trim().ToLower())
					{
						flag = true;
						break;
					}
				}
				if (flag && SetupApi.CM_Get_DevNode_Status(out var _, out var _, DeviceInfoData.DevInst, 0u) == SetupApi.CR.NO_SUCH_DEVNODE && SetupApi.SetupDiGetDeviceRegistryProperty(out uint value, intPtr, ref DeviceInfoData, SetupApi.SPDRP.CONFIGFLAGS))
				{
					value |= 0x20u;
					uint[] propertyBuffer = new uint[1] { value };
					if (SetupApi.SetupDiSetDeviceRegistryProperty(intPtr, ref DeviceInfoData, SetupApi.SPDRP.CONFIGFLAGS, propertyBuffer, Marshal.SizeOf(typeof(uint))))
					{
						num++;
					}
				}
			}
			_ = 0;
			SetupApi.SetupDiDestroyDeviceInfoList(intPtr);
			return num;
		}

		public static bool InstallSetupPackage(string hardwareId, string infPath)
		{
			if (SetupApi.UpdateDriverForPlugAndPlayDevices(IntPtr.Zero, hardwareId, infPath, SetupApi.INSTALLFLAG.FORCE, IntPtr.Zero))
			{
				UpdateDriver(hardwareId);
				return true;
			}
			if (Marshal.GetLastWin32Error() != -536870389)
			{
				return false;
			}
			StringBuilder stringBuilder = new StringBuilder(1024);
			uint RequiredSize;
			bool result = SetupApi.SetupCopyOEMInf(infPath, null, SetupApi.SPOST.SPOST_PATH, 0u, stringBuilder, (uint)stringBuilder.Capacity, out RequiredSize, null);
			CheckRemoved(hardwareId);
			return result;
		}
	}
