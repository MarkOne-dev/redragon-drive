		private static void loadResourcesFromPath(string path)
		{
			try
			{
				if (Directory.Exists(path))
				{
					string[] files = Directory.GetFiles(path, "*.driver.resources");
					for (int i = 0; i < files.Length; i++)
					{
						DriverResource driverResource = new DriverResource(files[i]);
						ResourceList.Add(driverResource);
					}
					if (ResourceList.Count <= 0)
					{
					}
				}
			}
			catch (Exception)
			{
			}
		}

		private static void loadResourcesFromAssembly(Assembly assembly)
		{
			try
			{
				string[] manifestResourceNames = assembly.GetManifestResourceNames();
				foreach (string text in manifestResourceNames)
				{
					if (text.ToLower().EndsWith(".driver.resources"))
					{
						DriverResource driverResource = new DriverResource(assembly.GetManifestResourceStream(text));
						ResourceList.Add(driverResource);
					}
				}
			}
			catch (Exception)
			{
			}
		}

		public static bool LoadResources()
		{
			mDriverResourceList = new DriverResourceList();
			DirectoryInfo directoryInfo = new DirectoryInfo(Path.GetDirectoryName(Application.ExecutablePath));
			DirectoryInfo directoryInfo2 = new DirectoryInfo(Environment.CurrentDirectory);
			List<string> list = new List<string>();
			list.Add(directoryInfo.FullName);
			string fullName = directoryInfo.FullName;
			char directorySeparatorChar = Path.DirectorySeparatorChar;
			list.Add(fullName + directorySeparatorChar + "DriverResources");
			if (directoryInfo.FullName != directoryInfo2.FullName)
			{
				list.Add(directoryInfo2.FullName);
				string fullName2 = directoryInfo2.FullName;
				directorySeparatorChar = Path.DirectorySeparatorChar;
				list.Add(fullName2 + directorySeparatorChar + "DriverResources");
			}
			foreach (string item in list)
			{
				loadResourcesFromPath(item);
			}
			loadResourcesFromAssembly(Assembly.GetExecutingAssembly());
			if (mDriverResourceList.Count == 0)
			{
				return false;
			}
			return true;
		}

		public static bool Check()
		{
			bool result = false;
			if (mDriverResourceList != null && mDriverResourceList.Count > 0)
			{
				foreach (DriverResource mDriverResource in mDriverResourceList)
				{
					if (mDriverResource.Strings.ContainsKey(DrvResKey.Description.ToString()) && mDriverResource.Strings.ContainsKey(DrvResKey.DisplayName.ToString()))
					{
						result = true;
						break;
					}
				}
			}
			return result;
		}
	}
