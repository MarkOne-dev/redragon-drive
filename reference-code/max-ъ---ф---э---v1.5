		public static byte GetCommandCRC(byte[] cmd)
		{
			int num = 0;
			for (int i = 0; i < cmd.Length; i++)
			{
				num += cmd[i];
			}
			byte b = (byte)((uint)num & 0xFFu);
			return (byte)(85 - b);
		}

