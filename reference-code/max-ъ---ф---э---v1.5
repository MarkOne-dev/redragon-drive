	public class RegistryStorage
	{
		public static string OpenAfterStart()
		{
			string result = "";
			RegistryKey registryKey = Registry.CurrentUser.OpenSubKey("Software\\RegistryStorage");
			if (registryKey != null)
			{
				result = (string)registryKey.GetValue("CustomLanguage");
				registryKey.Close();
			}
			return result;
		}

		public static void SaveBeforeExit(string text)
		{
			RegistryKey registryKey = Registry.CurrentUser.CreateSubKey("Software\\RegistryStorage");
			registryKey.SetValue("CustomLanguage", text);
			registryKey.Close();
		}
	}
