			if (fiDest.Exists && !mbAllowOverwrite)
			{
				throw new NotSupportedException("Destination file already exists. See the AllowOverwrite property.\r\nDest:" + fiDest.FullName);
			}
			StreamReader streamReader = new StreamReader(fiSource.FullName);
			string taggedData = streamReader.ReadToEnd();
			streamReader.Close();
			if (fiDest.Exists)
			{
				fiDest.Delete();
			}
			StreamWriter streamWriter = new StreamWriter(fiDest.FullName);
			streamWriter.Write(TagString(ref taggedData));
