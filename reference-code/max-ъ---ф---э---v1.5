	public class USBDevice
	{
		public List<USBEndPoint> EndPoints = new List<USBEndPoint>();

		public int id;

		public bool isValid = true;

		private int WriteFeatureEndPointId;

		private int GetFeatureEndPointId;

		public USBDevice(int index)
		{
			id = index;
			isValid = true;
			EndPoints.Clear();
		}

		public void AddEndPoint(string shortDevicePath)
		{
			for (int i = 0; i < EndPoints.Count; i++)
			{
				if (EndPoints[i].shortDevicePath.Contains(shortDevicePath))
				{
					return;
				}
			}
			EndPoints.Add(new USBEndPoint(shortDevicePath));
		}

		public void AddEndPoint(string[] shortDevicePath)
		{
			for (int i = 0; i < shortDevicePath.Length; i++)
			{
				AddEndPoint(shortDevicePath[i]);
			}
		}

		public void SetWriteFeatureEndPointId(int id)
		{
			WriteFeatureEndPointId = id;
		}

		public void SetGetFeatureEndPointId(int id)
		{
			GetFeatureEndPointId = id;
		}

		public bool canOpen(List<string> allUsbDeviceList)
		{
			if (EndPoints.Count > 0)
			{
				for (int i = 0; i < EndPoints.Count; i++)
				{
					foreach (string allUsbDevice in allUsbDeviceList)
					{
						if (allUsbDevice.Contains(EndPoints[i].shortDevicePath) && !EndPoints[i].canOpen(allUsbDevice))
						{
							return false;
						}
					}
				}
				return true;
			}
			return false;
		}

		public USBEndPoint FindEndPoint(string endPointShortKey)
		{
			for (int i = 0; i < EndPoints.Count; i++)
			{
				if (EndPoints[i].shortDevicePath.Contains(endPointShortKey))
				{
					return EndPoints[i];
				}
			}
			return null;
		}

		public bool Open(List<string> allUsbDeviceList)
		{
			bool flag = false;
			bool flag2 = false;
			for (int i = 0; i < EndPoints.Count; i++)
			{
				if (!EndPoints[i].devicePath.Equals(""))
				{
					flag = true;
				}
			}
			if (!flag)
			{
				foreach (string allUsbDevice in allUsbDeviceList)
				{
					for (int j = 0; j < EndPoints.Count; j++)
					{
						if (allUsbDevice.Contains(EndPoints[j].shortDevicePath))
						{
							string deviceId = GetDeviceId();
							string deviceId2 = GetDeviceId(EndPoints[j].shortDevicePath, allUsbDevice);
							if ((deviceId == "" || deviceId.Equals(deviceId2)) && EndPoints[j].Open(allUsbDevice))
							{
								flag = true;
							}
						}
					}
				}
			}
			foreach (string allUsbDevice2 in allUsbDeviceList)
			{
				for (int k = 0; k < EndPoints.Count; k++)
				{
					if (!EndPoints[k].devicePath.Equals("") && allUsbDevice2.Contains(EndPoints[k].devicePath))
					{
						flag2 = true;
					}
				}
			}
			if (!flag2)
			{
				Close();
			}
			return flag;
		}

		public string GetDeviceId()
		{
			string text = "";
			for (int i = 0; i < EndPoints.Count; i++)
			{
				text = GetDeviceId(EndPoints[i].shortDevicePath, EndPoints[i].devicePath);
				if (text != "")
				{
					break;
				}
			}
			return text;
		}

		public string GetDeviceId(string shortPath, string fullPath)
		{
			string result = "";
			if (!shortPath.Equals("") && !fullPath.Equals(""))
			{
				int num = fullPath.IndexOf(shortPath);
				num += shortPath.Length;
				if (num < fullPath.Length)
				{
					string text = fullPath.Substring(num);
					num = text.IndexOf('&');
					string text2 = text.Substring(num + 1);
					result = text2[..text2.IndexOf('&')];
				}
			}
			return result;
		}

		public bool WriteFeature(int epId, byte[] data)
		{
			if (isValid && epId < EndPoints.Count && EndPoints[epId].IsOpened() && data != null)
			{
				return EndPoints[epId].WriteFeature(data);
			}
			return false;
		}

		public bool WriteFeature(byte[] data)
		{
			if (isValid)
			{
				return WriteFeature(WriteFeatureEndPointId, data);
			}
			return false;
		}

		public bool WriteOutRport(int epId, byte[] data)
		{
			if (isValid)
			{
				return EndPoints[epId].WriteOutputReport(data);
			}
			return false;
		}

		public byte[] GetFeature(int epId, byte reportId, int reportLength)
		{
			if (reportLength == 0 || !isValid)
			{
				return null;
			}
			byte[] array = new byte[reportLength];
			array[0] = reportId;
			if (epId < EndPoints.Count && EndPoints[epId].IsOpened() && EndPoints[epId].GetFeature(array))
			{
				return array;
			}
			return null;
		}

		public byte[] GetFeature(byte reportId, int reportLength)
		{
			return GetFeature(GetFeatureEndPointId, reportId, reportLength);
		}

		public void SetValid(bool valid)
		{
			isValid = valid;
		}

		public void Remove()
		{
			SetValid(valid: false);
		}

		public bool IsOpened()
		{
			bool result = isValid;
			if (isValid)
			{
				for (int i = 0; i < EndPoints.Count; i++)
				{
					if (!EndPoints[i].IsOpened())
					{
						result = false;
					}
				}
			}
			return result;
		}

		public void Close()
		{
			for (int i = 0; i < EndPoints.Count; i++)
			{
				EndPoints[i].CloseDevice();
			}
		}
