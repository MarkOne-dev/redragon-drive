				dynamicPropDescriptors = DynSortPropsByNatural.Sort(mInstance.GetType().GetProperties(), dynamicPropDescriptors);
				break;
			case DynPropertySortTypes.UsePropertySortAttributes:
				dynamicPropDescriptors.Sort(new DynSortPropsByAttribute());
				break;
			}
			mPropDescriptors = dynamicPropDescriptors;
			PropertyDescriptor[] array = new PropertyDescriptor[dynamicPropDescriptors.Count];
			for (int i = 0; i < array.Length; i++)
			{
				array[i] = dynamicPropDescriptors[i];
			}
			return new PropertyDescriptorCollection(array);
		}

		private void doAttributeOverrides(DynPropertyOverride dynProp, List<Attribute> newAttributeList)
		{
			foreach (DynAttribute @override in dynProp.Overrides)
			{
				int num = -1;
				if (@override.Value == null)
				{
					continue;
				}
				for (int i = 0; i < newAttributeList.Count; i++)
				{
					if (@override.Equals(newAttributeList[i]))
					{
						num = i;
						break;
					}
				}
				if (num != -1)
				{
					newAttributeList.RemoveAt(num);
					newAttributeList.Insert(num, @override.Value);
				}
				else
				{
					newAttributeList.Add(@override.Value);
				}
			}
		}
	}
