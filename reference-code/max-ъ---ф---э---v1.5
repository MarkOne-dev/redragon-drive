	internal class InfWriter
	{
		private readonly DeviceItem mDeviceItem;

		private readonly DriverResource mDriverResource;

		private string mDriverDirectory;

		private TagNReplaceString mTagger;

		public string DriverDirectory
		{
			get
			{
				if (mDriverDirectory == null)
				{
					if (mDeviceItem.CreateDriverDirectory)
					{
						mDriverDirectory = Path.Combine(mDeviceItem.SaveDirectory, mDeviceItem.BaseFilename);
					}
					else
					{
						mDriverDirectory = mDeviceItem.SaveDirectory;
					}
					if (!Directory.Exists(mDriverDirectory))
					{
						Directory.CreateDirectory(mDriverDirectory);
					}
				}
				return mDriverDirectory;
			}
		}

		public TagNReplaceString Tagger
		{
			get
			{
				if (mTagger == null)
				{
					TagNReplaceString tagNReplaceString = new TagNReplaceString();
					tagNReplaceString[InfTagKeys.BASE_FILENAME.ToString()] = mDeviceItem.BaseFilename;
					tagNReplaceString[InfTagKeys.INF_FILENAME.ToString()] = mDeviceItem.BaseFilename + ".inf";
					tagNReplaceString[InfTagKeys.CAT_FILENAME.ToString()] = mDeviceItem.BaseFilename + ".cat";
					tagNReplaceString[InfTagKeys.DRIVER_DATE.ToString()] = mDeviceItem.DriverDate.Date.ToString("MM/dd/yyyy");
					tagNReplaceString[InfTagKeys.DRIVER_VERSION.ToString()] = mDeviceItem.DriverVersion;
					tagNReplaceString[InfTagKeys.DEVICE_DESCRIPTION.ToString()] = mDeviceItem.DeviceDescription;
					tagNReplaceString[InfTagKeys.VID.ToString()] = mDeviceItem.VendorID;
					tagNReplaceString[InfTagKeys.PID.ToString()] = mDeviceItem.ProductID;
					tagNReplaceString[InfTagKeys.MI.ToString()] = mDeviceItem.MI;
					tagNReplaceString[InfTagKeys.HARDWAREID.ToString()] = mDeviceItem.BuildInfHardwareID();
					tagNReplaceString[InfTagKeys.DEVICE_HARDWARE_ID.ToString()] = mDeviceItem.BuildInfHardwareID().Substring(4);
					tagNReplaceString[InfTagKeys.DEVICE_MANUFACTURER.ToString()] = mDeviceItem.Manufacturer;
					tagNReplaceString[InfTagKeys.DEVICE_INTERFACE_GUID.ToString()] = "{" + mDeviceItem.DeviceInterfaceGuid + "}";
					tagNReplaceString.Formatters.Add(new StandardTagValueFormatter("#", "#", formatReturnValue: false));
					mTagger = tagNReplaceString;
				}
				return mTagger;
			}
		}

		public InfWriter(DeviceItem deviceItem, DriverResource driverResource)
		{
			mDeviceItem = deviceItem;
			mDriverResource = driverResource;
		}

		public void SaveDefaults()
		{
		}

		public bool WriteStringFiles(ref List<string> resultInfoList)
		{
			bool result = true;
			string text = Path.Combine(DriverDirectory, "README_" + mDeviceItem.BaseFilename + ".htm");
			try
			{
				foreach (KeyValuePair<string, string> @string in mDriverResource.Strings)
				{
					if (!@string.Key.Contains("."))
					{
						Tagger[@string.Key] = @string.Value;
					}
				}
				foreach (KeyValuePair<string, string> string2 in mDriverResource.Strings)
				{
					if (!string2.Key.Contains("."))
					{
						continue;
					}
					string text2 = Tagger.TagString(string2.Key);
					string text3 = Path.Combine(DriverDirectory, text2);
					if (!(text3.ToLower() == text.ToLower()))
					{
						resultInfoList.Add("writing driver file:" + text2);
						string directoryName = Path.GetDirectoryName(text3);
						if (!Directory.Exists(directoryName))
						{
							Directory.CreateDirectory(directoryName);
						}
						if (File.Exists(text3))
						{
							File.Delete(text3);
						}
						string contents = Tagger.TagString(string2.Value);
						File.WriteAllText(text3, contents, Encoding.ASCII);
					}
				}
			}
			catch (Exception ex)
			{
				resultInfoList.Add("failed writing string driver resource " + ex);
				result = false;
			}
			return result;
		}

		public string GetDriverPathFilename(string extention)
		{
			return Path.Combine(DriverDirectory, $"{mDeviceItem.BaseFilename}.{extention.TrimStart(new char[1] { '.' })}");
		}

		public bool WriteDataFiles(ref List<string> resultInfoList)
		{
			try
			{
				foreach (KeyValuePair<string, byte[]> file in mDriverResource.Files)
				{
					string text = Path.Combine(DriverDirectory, Tagger.TagString(file.Key));
					string directoryName = Path.GetDirectoryName(text);
					resultInfoList.Add("writing driver file:" + text);
					if (!Directory.Exists(directoryName))
					{
						Directory.CreateDirectory(directoryName);
					}
					if (File.Exists(text))
					{
						File.Delete(text);
					}
					File.WriteAllBytes(text, file.Value);
				}
				return true;
			}
			catch (Exception ex)
			{
				resultInfoList.Add("failed writing data file driver resource: " + ex);
			}
			return false;
		}
	}
