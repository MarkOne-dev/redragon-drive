		public static int EnumerateDevices(DeviceEnumeratorInfo deviceEnumeratorInfo)
		{
			SetupApi.SP_DEVINFO_DATA DeviceInfoData = default(SetupApi.SP_DEVINFO_DATA);
			DeviceInfoData.cbSize = (uint)Marshal.SizeOf(typeof(SetupApi.SP_DEVINFO_DATA));
			RegHardwareID globalInstance = RegHardwareID.GlobalInstance;
			byte[] array = new byte[1024];
			IntPtr intPtr = SetupApi.SetupDiGetClassDevs(0, "USB", deviceEnumeratorInfo.Hwnd, deviceEnumeratorInfo.DICFGFlags);
			if (intPtr == IntPtr.Zero || intPtr == new IntPtr(-1))
			{
				return -1;
			}
			int i;
			for (i = 0; SetupApi.SetupDiEnumDeviceInfo(intPtr, i, ref DeviceInfoData); i++)
			{
				DeviceItem deviceItem = new DeviceItem();
				if (SetupApi.SetupDiGetDeviceRegistryProperty(intPtr, ref DeviceInfoData, SetupApi.SPDRP.DRIVER, out var PropertyRegDataType, array, array.Length, out var RequiredSize))
				{
					deviceItem.mDriverless = false;
					IntPtr intPtr2 = SetupApi.SetupDiOpenDevRegKey(intPtr, ref DeviceInfoData, 1, 0, DevKeyType.DRV, 1);
					if (intPtr2 != IntPtr.Zero && intPtr2 != new IntPtr(-1))
					{
						int num = 0;
						int lpcValueName = 255;
						int dataLength = 1023;
						deviceItem.mDriverRegistryList = new Dictionary<string, object>();
						StringBuilder stringBuilder = new StringBuilder(lpcValueName + 1);
						StringBuilder stringBuilder2 = new StringBuilder(dataLength + 1);
						RegistryValueKind lpType;
						while (SetupApi.RegEnumValue(intPtr2, num, stringBuilder, ref lpcValueName, IntPtr.Zero, out lpType, stringBuilder2, ref dataLength) == 0)
						{
							if (lpType == RegistryValueKind.String)
							{
								deviceItem.mDriverRegistryList.Add(stringBuilder.ToString(), stringBuilder2.ToString());
							}
							num++;
							lpcValueName = 255;
							dataLength = 1023;
						}
						SetupApi.RegCloseKey(intPtr2);
					}
				}
				else
				{
					deviceItem.mDriverless = true;
				}
				deviceItem.mIsConnected = SetupApi.CM_Get_DevNode_Status(out var _, out var pulProblemNumber, DeviceInfoData.DevInst, 0u) != SetupApi.CR.NO_SUCH_DEVNODE;
				if (deviceItem.mIsConnected)
				{
					deviceItem.mIsConnected = (pulProblemNumber & 0x2D) != 45;
				}
				if (deviceEnumeratorInfo.DriverlessOnly && !deviceItem.mDriverless)
				{
					continue;
				}
				if (!SetupApi.SetupDiGetDeviceRegistryProperty(intPtr, ref DeviceInfoData, SetupApi.SPDRP.SERVICE, out PropertyRegDataType, array, array.Length, out RequiredSize))
				{
					deviceItem.mServiceName = string.Empty;
				}
				else
				{
					deviceItem.mServiceName = GetAsAutoString(array);
				}
				bool flag = true;
				string[] array2 = mSkipServiceNames;
				foreach (string text in array2)
				{
					if (deviceItem.mServiceName.Trim().ToLower() == text)
					{
						flag = false;
						break;
					}
				}
				if (!flag && deviceEnumeratorInfo.SkipWindowsServices)
				{
					continue;
				}
				deviceItem.mIsSkipServiceName = !flag;
				if (!SetupApi.SetupDiGetDeviceRegistryProperty(out string[] regMultiSZ, intPtr, ref DeviceInfoData, SetupApi.SPDRP.HARDWAREID) || regMultiSZ.Length == 0 || SetupApi.CM_Get_Device_ID(DeviceInfoData.DevInst, array, array.Length, 0) != 0)
				{
					continue;
				}
				deviceItem.mDeviceId = GetAsAutoString(array);
				string regSZ;
				if (SetupApi.WindowsVersion < WindowsVersionType.WINDOWS_7)
				{
					if (!SetupApi.SetupDiGetDeviceRegistryProperty(out regSZ, intPtr, ref DeviceInfoData, SetupApi.SPDRP.DEVICEDESC))
					{
						regSZ = string.Empty;
					}
				}
				else
				{
					try
					{
						flag = SetupApi.SetupDiGetDeviceProperty(intPtr, ref DeviceInfoData, SetupApi.DEVPKEY_Device_BusReportedDeviceDesc, out PropertyRegDataType, array, array.Length, out RequiredSize, 0);
					}
					catch (DllNotFoundException)
					{
						flag = false;
					}
					if (flag)
					{
						regSZ = GetAsAutoString(array);
					}
					else if (!SetupApi.SetupDiGetDeviceRegistryProperty(out regSZ, intPtr, ref DeviceInfoData, SetupApi.SPDRP.DEVICEDESC))
					{
						regSZ = string.Empty;
					}
				}
				deviceItem.DeviceDescription = regSZ;
				deviceItem.BaseFilename = regSZ;
				foreach (Match item in globalInstance.Matches(regMultiSZ[0]))
				{
					NamedGroup[] nAMED_GROUPS = RegHardwareID.NAMED_GROUPS;
					for (int j = 0; j < nAMED_GROUPS.Length; j++)
					{
						RegHardwareID.ENamedGroups groupNumber = (RegHardwareID.ENamedGroups)nAMED_GROUPS[j].GroupNumber;
						Group group = item.Groups[(int)groupNumber];
						if (!group.Success)
						{
							continue;
						}
						switch (groupNumber)
						{
						case RegHardwareID.ENamedGroups.Vid:
							deviceItem.VendorID = group.Value;
							break;
						case RegHardwareID.ENamedGroups.Pid:
							deviceItem.ProductID = group.Value;
							break;
						case RegHardwareID.ENamedGroups.MI:
							deviceItem.MI = group.Value;
							if (deviceItem.MI != string.Empty)
							{
								deviceItem.DeviceDescription += $" (Interface #{deviceItem.mMI})";
							}
							break;
						default:
							throw new ArgumentOutOfRangeException();
						case RegHardwareID.ENamedGroups.Rev:
							break;
						}
					}
				}
				if (deviceItem.mVid != 0 || deviceItem.mPid != 0)
				{
					if (!SetupApi.SetupDiGetDeviceRegistryProperty(out string regSZ2, intPtr, ref DeviceInfoData, SetupApi.SPDRP.MFG))
					{
						regSZ2 = string.Empty;
					}
					deviceItem.Manufacturer = regSZ2;
					string[] array3 = new string[0];
					if (SetupApi.SetupDiGetCustomDeviceProperty(intPtr, ref DeviceInfoData, "DeviceInterfaceGUIDs", SetupApi.DICUSTOMDEVPROP.NONE, out PropertyRegDataType, array, array.Length, out RequiredSize))
					{
						array3 = GetAsAutoStringArray(array, RequiredSize);
					}
					if (array3.Length != 0)
					{
						deviceItem.DeviceInterfaceGuid = array3[0];
					}
					if (!deviceEnumeratorInfo.DeviceFound(deviceItem, intPtr, ref DeviceInfoData))
					{
						break;
					}
				}
			}
			SetupApi.SetupDiDestroyDeviceInfoList(intPtr);
			return i;
		}
	}
